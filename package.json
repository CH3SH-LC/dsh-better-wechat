{
  "name": "dsh-better-wechat",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "本地优先的微信消息整理助手：把电脑微信聊天变成可检索、可筛选、可复盘的个人工作台。采集、解密与索引全部在本机完成，只有本次分析选中的消息文本会交给 DSH 里的模型；免打扰群可一键忽略。",
  "license": "MIT AND Apache-2.0",
  "exports": {
    ".": "./index.js",
    "./core": "./components/core.js",
    "./stage-one": "./components/stage-one.js",
    "./read": "./components/read.js",
    "./tasks": "./components/tasks.js",
    "./preferences": "./components/preferences.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
